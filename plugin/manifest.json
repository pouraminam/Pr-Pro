{
  "manifestVersion": 5,
  "id": "com.premiere.ai.editor",
  "name": "Premiere AI Editor",
  "version": "1.0.0",
  "main": "index.html",
  "host": [
    {
      "app": "PPRO",
      "minVersion": "24.0.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "aiEditorPanel",
      "label": {
        "default": "Premiere AI Editor"
      },
      "minimumSize": {
        "width": 320,
        "height": 450
      },
      "preferredDockedSize": {
        "width": 380,
        "height": 720
      },
      "maximumSize": {
        "width": 1200,
        "height": 1400
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "assets/icon.png"
        }
      ]
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "network": {
      "domains": [
        "http://127.0.0.1:*",
        "http://localhost:*",
        "ws://127.0.0.1:*",
        "ws://localhost:*"
      ]
    },
    "clipboard": "readAndWrite",
    "launchProcess": {
      "schemes": [
        "http",
        "https"
      ],
      "extensions": [
        ".bat",
        ".cmd",
        ".exe",
        ".sh",
        ".ps1"
      ]
    }
  }
}
